{
  "name": "n8n-nodes-smstunnel",
  "version": "1.1.0",
  "description": "n8n community node for SMSTunnel — send texts from your workflows through your own Android phone and number.",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "smstunnel",
    "sms",
    "android",
    "android-sms",
    "send-sms-from-computer",
    "sms-sync",
    "own-number",
    "notifications",
    "2fa"
  ],
  "license": "MIT",
  "homepage": "https://smstunnel.io",
  "author": {
    "name": "Narcis Bodea",
    "email": "contact@narboweb.ro"
  },
  "engines": {
    "node": ">=18.10"
  },
  "main": "index.js",
  "scripts": {
    "build": "npx rimraf dist && tsc && gulp build:icons",
    "dev": "tsc --watch",
    "format": "prettier nodes credentials --write",
    "lint": "eslint nodes credentials package.json",
    "lintfix": "eslint nodes credentials package.json --fix",
    "test": "npm run build && node --test test/SmsTunnel.node.test.js",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/SmsTunnelApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/SmsTunnel/SmsTunnel.node.js"
    ]
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@typescript-eslint/parser": "^7.15.0",
    "eslint": "^8.57.0",
    "eslint-plugin-n8n-nodes-base": "^1.16.1",
    "gulp": "^5.0.0",
    "n8n-workflow": "*",
    "prettier": "^3.3.2",
    "rimraf": "^5.0.7",
    "typescript": "^5.5.3"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
