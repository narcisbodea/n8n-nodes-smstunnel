{
  "name": "n8n-nodes-smstunnel",
  "version": "1.1.0",
  "description": "n8n community node for SMSTunnel — send texts from your workflows through your own Android phone and number.",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "smstunnel",
    "sms",
    "android",
    "android-sms",
    "send-sms-from-computer",
    "sms-sync",
    "own-number",
    "notifications",
    "2fa"
  ],
  "license": "MIT",
  "homepage": "https://smstunnel.io",
  "author": {
    "name": "Narcis Bodea",
    "email": "contact@narboweb.ro"
  },
  "engines": {
    "node": ">=18.10"
  },
  "main": "index.js",
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "format": "prettier nodes credentials --write",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "test": "npm run build && node --test \"test/*.test.js\"",
    "prepublishOnly": "n8n-node prerelease"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/SmsTunnelApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/SmsTunnel/SmsTunnel.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "^0.57.3",
    "@types/node": "^20.19.43",
    "eslint": "^9.39.4",
    "n8n-workflow": "*",
    "prettier": "^3.3.2",
    "typescript": "^5.5.3"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
